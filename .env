# Configuración del Web Service de Consentimientos
# Copie este archivo a .env y configure los valores apropiados

# URL base del servicio de consentimientos
VITE_WEBSERVICE_BASE_URL=http://127.0.0.1:3000

# Clave de API para autenticación (NO incluir en repositorio)
VITE_WEBSERVICE_API_KEY=

# Habilitar/deshabilitar el envío al web service
VITE_WEBSERVICE_ENABLED=true

# Entorno de ejecución (development, staging, production)
VITE_WEBSERVICE_ENVIRONMENT=development

# Habilitar logs de debug
VITE_WEBSERVICE_DEBUG=true

# Configuración adicional para producción
# VITE_WEBSERVICE_TIMEOUT=30000
# VITE_WEBSERVICE_MAX_RETRIES=3
# VITE_WEBSERVICE_RETRY_INTERVAL=1000